# Local development: never expose this mode to the Internet.
FLAVO_ENV=development
FLAVO_PUBLIC_URL=http://127.0.0.1:4175
FLAVO_MODEL=qwen3.5:9b
OLLAMA_HOST=http://127.0.0.1:11434
# FLAVO_DATABASE=C:/flavo/var/flavo.sqlite3

# Production: set FLAVO_ENV=production and an HTTPS origin.
# Create TWO recurring monthly Prices in your Stripe account.
# Keep all keys server-side. Use test keys before live keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_TEAM=

# STARTTLS SMTP for verification, password reset and team invitations.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Docker Compose / Caddy: use a domain you control, pointed to this host.
FLAVO_DOMAIN=
# Only trusted reverse-proxy IPs. Compose uses a private proxy/API network.
FORWARDED_ALLOW_IPS=127.0.0.1
# Pin a tested official Ollama image tag/digest before deployment.
OLLAMA_IMAGE=ollama/ollama:0.40.2
